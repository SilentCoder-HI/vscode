{
  "name": "My Own IDE",
  "private": true,
  "version": "0.0.0",
  "description": "A React and Electron Linux desktop application",
  "author": "Your Name",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "build": "vite build",
    "start": "electron .",
    "code": "./scripts/code.sh",
    "code:web": "./scripts/code-web.sh",
    "code:both": "./scripts/code-both.sh",
    "dist:linux": "npm run build && electron-builder --linux appImage deb",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "adm-zip": "^0.6.0",
    "monaco-editor": "^0.56.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "concurrently": "^9.2.1",
    "electron": "^39.0.0",
    "electron-builder": "^26.0.12",
    "oxlint": "^1.79.0",
    "vite": "^8.2.2",
    "wait-on": "^9.0.1"
  },
  "build": {
    "appId": "com.example.electronreactapp",
    "productName": "Electron React App",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "linux": {
      "category": "Utility",
      "desktopName": "electron-react-app",
      "target": [
        "AppImage",
        "deb"
      ]
    }
  }
}
